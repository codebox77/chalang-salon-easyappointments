# Secrets: generated per server (live: edited by hand, Docker: from environment variables).
/config.php
/docker/.env
/docker/initdb/

# Runtime data of the live site: logs (may hold personal data), sessions, cache, uploads, backups.
/storage/*/*
!/storage/*/.htaccess
!/storage/*/index.html

