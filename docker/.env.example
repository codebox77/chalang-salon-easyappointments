# Copy to docker/.env and fill in. docker/.env is NOT copied into the image (see .dockerignore).

# Address customers use (no trailing slash), e.g. https://minsol.pe.kr/crcr or https://booking.example.com
BASE_URL=http://localhost:8080

# Port on the host that serves the site (put a reverse proxy with HTTPS in front of it).
APP_PORT=8080

# Database (the app uses its own user, not root).
DB_NAME=easyappointments
DB_USERNAME=easyappointments
DB_PASSWORD=change-me-long-random
DB_ROOT_PASSWORD=change-me-another-long-random

# Optional: Kakao JavaScript key (can also be set in 관리자 → 설정 → 연동 → 카카오).
KAKAO_JAVASCRIPT_KEY=

# Image to deploy with docker/docker-compose.deploy.yml (published by the GitHub Actions workflow).
APP_IMAGE=ghcr.io/OWNER/REPO:latest
